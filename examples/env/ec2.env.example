# Referencia para o deploy futuro: nao e um arquivo pronto para executar.
# A automacao deve substituir os placeholders; Docker --env-file nao os resolve.
# Nao copie o .env local para a EC2. Consulte docs/PLANO_AUTOMACAO.md.

PORT=8080
DB_URL=jdbc:mysql://<endereco-privado-do-banco>:3306/NOCTUA
DB_USERNAME=noctua_api
DB_PASSWORD=<senha-obtida-do-armazenamento-de-segredos>
DB_POOL_SIZE=3

ATHENA_ENABLED=true
AWS_REGION=<regiao-da-stack>
ATHENA_DATABASE=<output-GlueDatabaseName>
ATHENA_CATALOG=AwsDataCatalog
ATHENA_WORKGROUP=<output-AthenaWorkGroupName>
# Vazio: o workgroup deve configurar/impor a localizacao dos resultados.
ATHENA_OUTPUT_LOCATION=
ATHENA_QUERY_TIMEOUT=30s
ATHENA_POLL_INTERVAL=500ms
ATHENA_MAX_ROWS=10000

# Estes SQLs ja sao incluidos na imagem pelo Dockerfile, sem montagem.
ATHENA_SQL_TOTAL=file:/app/config/funcionarios-total.sql
ATHENA_SQL_TECNOLOGIA=file:/app/config/funcionarios-tecnologia.sql
ATHENA_SQL_SENIORIDADE=file:/app/config/funcionarios-senioridade.sql
ATHENA_SQL_AREA=file:/app/config/funcionarios-area.sql

# Credenciais AWS vem do LabInstanceProfile via cadeia padrao do SDK.
# Omitir variaveis de chaves/token para nao sobrepor a role com uma sessao antiga.
