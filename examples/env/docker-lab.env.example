# Docker Desktop no Windows + MySQL na EC2 via tunel SSH + Athena.
# Copie este exemplo para .env na raiz e preencha os valores do ambiente.
# Guia integrado: docs/GUIA_TESTE_MYSQL_ATHENA.md
# Use --env-file .env; os SQLs ja estao incluidos na imagem em /app/config.
# Passo a passo Docker: etapa 4.2 do guia.

# MySQL: mantenha o tunel SSH local 13306 -> EC2 127.0.0.1:3306 aberto.
DB_URL=jdbc:mysql://host.docker.internal:13306/NOCTUA
DB_USERNAME=noctua_api
DB_PASSWORD=
DB_POOL_SIZE=3
PORT=8080

# Recursos Athena ja informados; confirme sua disponibilidade no laboratorio.
ATHENA_ENABLED=true
AWS_REGION=us-east-1
ATHENA_DATABASE=noctua_analytics
ATHENA_CATALOG=AwsDataCatalog
ATHENA_WORKGROUP=noctua-athena-wg
# Vazio: utiliza o destino de resultados imposto pelo workgroup da infraestrutura.
ATHENA_OUTPUT_LOCATION=
ATHENA_QUERY_TIMEOUT=30s
ATHENA_POLL_INTERVAL=500ms
ATHENA_MAX_ROWS=10000

# Caminhos internos do container; SQLs incluidos na imagem em /app/config.
ATHENA_SQL_TOTAL=file:/app/config/funcionarios-total.sql
ATHENA_SQL_TECNOLOGIA=file:/app/config/funcionarios-tecnologia.sql
ATHENA_SQL_SENIORIDADE=file:/app/config/funcionarios-senioridade.sql
ATHENA_SQL_AREA=file:/app/config/funcionarios-area.sql

# Preencha apenas no .env local. Nunca versione credenciais reais.
# No Learner Lab, renove os tres valores juntos e recrie o container.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
